# Root Environment Variables for Docker Compose Deployment

# Database credentials
DB_USER=timetable_user
DB_PASSWORD=timetable_secure_password_123
DB_NAME=timetable_db

# Backend security
SECRET_KEY=change-this-to-a-very-secure-random-64-character-string-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend API URL (client browser endpoint)
NEXT_PUBLIC_API_URL=http://localhost:8000
