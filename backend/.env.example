# Database configuration
# SQLite (default for development):
# DATABASE_URL=sqlite:///./timetable.db
# PostgreSQL (recommended for production):
DATABASE_URL=postgresql://user:password@localhost:5432/timetable_db

# Security & JWT
SECRET_KEY=generate-a-strong-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App Settings
APP_NAME=Timetable Generator
DEBUG=False

# CORS (comma-separated origins or * in development)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.vercel.app

